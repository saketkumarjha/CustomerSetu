    "field_labels": {
      "name": "Customer name",
      "contact": "Phone or email",
      "description": "Problem description",
      "txn_id": "Transaction ID / UTR",
      "txn_date": "Transaction date (DD/MM/YYYY)",
      "amount": "Transaction amount",
      "cif_or_account": "CIF or account number",
      "card_last4": "Card last 4 digits",
      "atm_location": "ATM location, address, or ID",
      "loan_account": "Loan account number"
    },
    "category_requirements": {
      "General Banking":                ["name", "contact", "description"],
      "UPI / IMPS / NEFT":             ["txn_id", "txn_date", "amount", "name", "cif_or_account"],
      "Debit Card":                     ["txn_date", "amount", "card_last4", "name", "cif_or_account"],
      "Credit Card":                    ["txn_date", "amount", "card_last4", "name", "cif_or_account"],
      "ATM":                            ["txn_date", "amount", "name", "cif_or_account"],
      "Home Loan":                      ["loan_account", "name", "contact"],
      "Personal Loan":                  ["loan_account", "name", "contact"],
      "Vehicle Loan":                   ["loan_account", "name", "contact"],
      "Fixed Deposit":                  ["cif_or_account", "name", "contact"],
      "Savings Account":                ["cif_or_account", "name", "description"],
      "Current Account":                ["cif_or_account", "name", "description"],
      "KYC / Account Opening":          ["name", "contact", "description"],
      "Unauthorized Transaction / Fraud": ["txn_id", "txn_date", "amount", "name", "cif_or_account"],
      "Internet Banking / Mobile App":  ["name", "contact", "description"],
      "Insurance":                      ["name", "contact", "description"],
      "Investment / Mutual Fund":       ["name", "contact", "description"]
    },
    "regex_extractors": {
      "txn_id": {
        "patterns": [
          "(?i)(?:utr|upi ref(?:erence)?|ref(?:erence)? no(?:.|:)?|txn id|transaction id|rrn|imps ref|neft ref)[:\\s#/-]*([A-Z0-9]{8,22})",
          "\\b([0-9]{12})\\b",
          "\\b([0-9]{15,22})\\b"
        ],
        "confidence": 0.95
      },
      "txn_date": {
        "patterns": [
          "\\b(0?[1-9]|[12]\\d|3[01])[/-](0?[1-9]|1[0-2])[/-](20\\d{2})\\b",
          "(20\\d{2})-(0?[1-9]|1[0-2])-(0?[1-9]|[12]\\d|3[01])\\b",
          "(?i)\\b(0?[1-9]|[12]\\d|3[01])\\s+(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\\s*(20\\d{2})\\b",
          "(?i)\\b(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\\s*(0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?[,\\s]*(20\\d{2})\\b"
        ],
        "confidence": 0.95,
        "reject_patterns": [
          "(?i)\\byesterday\\b",
          "(?i)\\btoday\\b",
          "(?i)\\blast\\s+(week|month|night|year)\\b",
          "(?i)\\bfew days\\b",
          "(?i)\\brecently\\b"
        ],
        "reject_confidence": 0.35
      },
      "amount": {
        "patterns": [
          "(?i)(?:rs\\.?|inr|rupees?|₹)\\s*([0-9]{1,3}(?:,[0-9]{2,3})*(?:\\.[0-9]{1,2})?|[0-9]+(?:\\.[0-9]{1,2})?)",
          "(?i)([0-9]+(?:\\.[0-9]+)?)\\s*(lakh|lac|crore|cr|thousand|k)\\b",
          "\\b([1-9][0-9]{2,8})\\s+(?=rupees?|rs|inr|debited|deducted|transferred|credited)"
        ],
        "confidence": 0.92
      },
      "cif": {
        "patterns": [
          "(?i)\\bcif[:\\s#/-]*([0-9]{6,12})\\b",
          "(?i)\\bcustomer\\s+(?:id|number|no)[:\\s#/-]*([0-9]{6,12})\\b"
        ],
        "confidence": 0.98
      },
      "account_number": {
        "patterns": [
          "(?i)\\b(?:a/?c|account|acct|acc)\\s*(?:no\\.?|number|num|#)?[:\\s#/-]*([0-9]{9,18})\\b",
          "(?i)\\b(?:sb|ca|od|cc)\\s+(?:no\\.?|number|account)[:\\s#/-]*([0-9]{9,18})\\b",
          "\\b([0-9]{9,18})\\b(?=\\s*(?:is|was|has|account|a/?c|debited|credited))"
        ],
        "confidence": 0.88
      },
      "card_last4": {
        "patterns": [
          "(?i)(?:card|debit card|credit card|ending(?:\\s+in)?|last\\s*4(?:\\s+digits?)?)[:\\s#/-]*(?:xxxx[\\s-]*|\\*{4}[\\s-]*)?([0-9]{4})\\b",
          "(?i)xxxx[\\s-]*xxxx[\\s-]*xxxx[\\s-]*([0-9]{4})\\b",
          "(?i)\\*{4}\\s*([0-9]{4})\\b"
        ],
        "confidence": 0.9
      },
      "atm_location": {
        "patterns": [
          "(?i)\\batm\\s+(?:at|near|located\\s+at|at\\s+the|on|in)[:\\s]*([A-Za-z0-9\\s,.-]{5,60})(?=\\.|,|\\n|$)",
          "(?i)\\batm\\s+(?:id|machine\\s+id|terminal\\s+id)[:\\s#/-]*([A-Z0-9]{4,20})\\b",
          "(?i)\\b([A-Za-z0-9\\s,.-]{5,50})\\s+atm\\b"
        ],
        "confidence": 0.72
      },
      "loan_account": {
        "patterns": [
          "(?i)\\b(?:loan|lan|loan\\s*a/?c|loan\\s*account|loan\\s*no\\.?)[:\\s#/-]*([A-Z0-9]{8,20})\\b",
          "(?i)\\b(?:home\\s+loan|personal\\s+loan|vehicle\\s+loan|car\\s+loan)\\s+(?:no\\.?|account|number)[:\\s#/-]*([A-Z0-9]{8,20})\\b"
        ],
        "confidence": 0.9
      },
      "phone": {
        "patterns": [
          "\\b(?:\\+91[\\s-]?|0)?[6-9][0-9]{9}\\b",
          "(?i)(?:mobile|phone|contact|whatsapp|mob(?:ile)?\\s*no\\.?)[:\\s#/-]*([6-9][0-9]{9})\\b"
        ],
        "confidence": 0.95
      },
      "email": {
        "patterns": [
          "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b"
        ],
        "confidence": 0.98
      }
    }
  }
}
