                    "fund transfer", "remittance", "not received", "not credited"],
        "secondary": ["gpay", "google pay", "phonepe", "paytm", "bhim", "bharat pay", "beneficiary"]
      },
      "Debit Card": {
        "primary": ["debit card", "debit card declined", "pos", "pos failed", "swipe failed"],
